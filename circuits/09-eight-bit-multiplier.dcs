# Demo 09 - 8-bit x 8-bit unsigned array multiplier. Multiplies
# A[7..0] by B[7..0] and produces the 16-bit product P[15..0].
# 16 inputs / 16 outputs - the largest curated demo. Structure is a
# textbook ripple-carry array multiplier: 64 partial products via
# AND, then 7 rows of XOR/AND/OR-based full-adders accumulate the
# shifted partial products column by column.
#
# This is the demo that stresses the v1.0.0 DOMAIN_MAX_IO = 32 bump
# (was 16) and the channelled auto-layout (U-41) at its scale limit.
# At 346 lines this is mostly mechanical — Python generated it using
# the array-multiplier recipe; the resulting .dcs is the artifact.

inputs: A0, A1, A2, A3, A4, A5, A6, A7, B0, B1, B2, B3, B4, B5, B6, B7
outputs: P0, P1, P2, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12, P13, P14, P15

# Partial products: pp_i_j = Ai AND Bj
# (P0 takes pp_0_0's slot �� bit 0 of the product is just A0 AND B0.)
P0 = and(A0, B0)
pp_0_1 = and(A0, B1)
pp_0_2 = and(A0, B2)
pp_0_3 = and(A0, B3)
pp_0_4 = and(A0, B4)
pp_0_5 = and(A0, B5)
pp_0_6 = and(A0, B6)
pp_0_7 = and(A0, B7)
pp_1_0 = and(A1, B0)
pp_1_1 = and(A1, B1)
pp_1_2 = and(A1, B2)
pp_1_3 = and(A1, B3)
pp_1_4 = and(A1, B4)
pp_1_5 = and(A1, B5)
pp_1_6 = and(A1, B6)
pp_1_7 = and(A1, B7)
pp_2_0 = and(A2, B0)
pp_2_1 = and(A2, B1)
pp_2_2 = and(A2, B2)
pp_2_3 = and(A2, B3)
pp_2_4 = and(A2, B4)
pp_2_5 = and(A2, B5)
pp_2_6 = and(A2, B6)
pp_2_7 = and(A2, B7)
pp_3_0 = and(A3, B0)
pp_3_1 = and(A3, B1)
pp_3_2 = and(A3, B2)
pp_3_3 = and(A3, B3)
pp_3_4 = and(A3, B4)
pp_3_5 = and(A3, B5)
pp_3_6 = and(A3, B6)
pp_3_7 = and(A3, B7)
pp_4_0 = and(A4, B0)
pp_4_1 = and(A4, B1)
pp_4_2 = and(A4, B2)
pp_4_3 = and(A4, B3)
pp_4_4 = and(A4, B4)
pp_4_5 = and(A4, B5)
pp_4_6 = and(A4, B6)
pp_4_7 = and(A4, B7)
pp_5_0 = and(A5, B0)
pp_5_1 = and(A5, B1)
pp_5_2 = and(A5, B2)
pp_5_3 = and(A5, B3)
pp_5_4 = and(A5, B4)
pp_5_5 = and(A5, B5)
pp_5_6 = and(A5, B6)
pp_5_7 = and(A5, B7)
pp_6_0 = and(A6, B0)
pp_6_1 = and(A6, B1)
pp_6_2 = and(A6, B2)
pp_6_3 = and(A6, B3)
pp_6_4 = and(A6, B4)
pp_6_5 = and(A6, B5)
pp_6_6 = and(A6, B6)
pp_6_7 = and(A6, B7)
pp_7_0 = and(A7, B0)
pp_7_1 = and(A7, B1)
pp_7_2 = and(A7, B2)
pp_7_3 = and(A7, B3)
pp_7_4 = and(A7, B4)
pp_7_5 = and(A7, B5)
pp_7_6 = and(A7, B6)
pp_7_7 = and(A7, B7)

# === Row 1: add A1*B (cols 1..8) into running sum ===
P1   = xor(pp_0_1, pp_1_0)
c1_2 = and(pp_0_1, pp_1_0)
t1_2   = xor(pp_0_2, pp_1_1)
s1_2   = xor(t1_2, c1_2)
u1_2   = and(pp_0_2, pp_1_1)
v1_2   = and(t1_2, c1_2)
c1_3 = or(u1_2, v1_2)
t1_3   = xor(pp_0_3, pp_1_2)
s1_3   = xor(t1_3, c1_3)
u1_3   = and(pp_0_3, pp_1_2)
v1_3   = and(t1_3, c1_3)
c1_4 = or(u1_3, v1_3)
t1_4   = xor(pp_0_4, pp_1_3)
s1_4   = xor(t1_4, c1_4)
u1_4   = and(pp_0_4, pp_1_3)
v1_4   = and(t1_4, c1_4)
c1_5 = or(u1_4, v1_4)
t1_5   = xor(pp_0_5, pp_1_4)
s1_5   = xor(t1_5, c1_5)
u1_5   = and(pp_0_5, pp_1_4)
v1_5   = and(t1_5, c1_5)
c1_6 = or(u1_5, v1_5)
t1_6   = xor(pp_0_6, pp_1_5)
s1_6   = xor(t1_6, c1_6)
u1_6   = and(pp_0_6, pp_1_5)
v1_6   = and(t1_6, c1_6)
c1_7 = or(u1_6, v1_6)
t1_7   = xor(pp_0_7, pp_1_6)
s1_7   = xor(t1_7, c1_7)
u1_7   = and(pp_0_7, pp_1_6)
v1_7   = and(t1_7, c1_7)
c1_8 = or(u1_7, v1_7)
s1_8   = xor(pp_1_7, c1_8)
q1_9 = and(pp_1_7, c1_8)

# === Row 2: add A2*B (cols 2..9) into running sum ===
P2   = xor(s1_2, pp_2_0)
c2_3 = and(s1_2, pp_2_0)
t2_3   = xor(s1_3, pp_2_1)
s2_3   = xor(t2_3, c2_3)
u2_3   = and(s1_3, pp_2_1)
v2_3   = and(t2_3, c2_3)
c2_4 = or(u2_3, v2_3)
t2_4   = xor(s1_4, pp_2_2)
s2_4   = xor(t2_4, c2_4)
u2_4   = and(s1_4, pp_2_2)
v2_4   = and(t2_4, c2_4)
c2_5 = or(u2_4, v2_4)
t2_5   = xor(s1_5, pp_2_3)
s2_5   = xor(t2_5, c2_5)
u2_5   = and(s1_5, pp_2_3)
v2_5   = and(t2_5, c2_5)
c2_6 = or(u2_5, v2_5)
t2_6   = xor(s1_6, pp_2_4)
s2_6   = xor(t2_6, c2_6)
u2_6   = and(s1_6, pp_2_4)
v2_6   = and(t2_6, c2_6)
c2_7 = or(u2_6, v2_6)
t2_7   = xor(s1_7, pp_2_5)
s2_7   = xor(t2_7, c2_7)
u2_7   = and(s1_7, pp_2_5)
v2_7   = and(t2_7, c2_7)
c2_8 = or(u2_7, v2_7)
t2_8   = xor(s1_8, pp_2_6)
s2_8   = xor(t2_8, c2_8)
u2_8   = and(s1_8, pp_2_6)
v2_8   = and(t2_8, c2_8)
c2_9 = or(u2_8, v2_8)
tL2_9   = xor(pp_2_7, c2_9)
s2_9   = xor(tL2_9, q1_9)
uL2_9   = and(pp_2_7, c2_9)
vL2_9   = and(tL2_9, q1_9)
q2_10 = or(uL2_9, vL2_9)

# === Row 3: add A3*B (cols 3..10) into running sum ===
P3   = xor(s2_3, pp_3_0)
c3_4 = and(s2_3, pp_3_0)
t3_4   = xor(s2_4, pp_3_1)
s3_4   = xor(t3_4, c3_4)
u3_4   = and(s2_4, pp_3_1)
v3_4   = and(t3_4, c3_4)
c3_5 = or(u3_4, v3_4)
t3_5   = xor(s2_5, pp_3_2)
s3_5   = xor(t3_5, c3_5)
u3_5   = and(s2_5, pp_3_2)
v3_5   = and(t3_5, c3_5)
c3_6 = or(u3_5, v3_5)
t3_6   = xor(s2_6, pp_3_3)
s3_6   = xor(t3_6, c3_6)
u3_6   = and(s2_6, pp_3_3)
v3_6   = and(t3_6, c3_6)
c3_7 = or(u3_6, v3_6)
t3_7   = xor(s2_7, pp_3_4)
s3_7   = xor(t3_7, c3_7)
u3_7   = and(s2_7, pp_3_4)
v3_7   = and(t3_7, c3_7)
c3_8 = or(u3_7, v3_7)
t3_8   = xor(s2_8, pp_3_5)
s3_8   = xor(t3_8, c3_8)
u3_8   = and(s2_8, pp_3_5)
v3_8   = and(t3_8, c3_8)
c3_9 = or(u3_8, v3_8)
t3_9   = xor(s2_9, pp_3_6)
s3_9   = xor(t3_9, c3_9)
u3_9   = and(s2_9, pp_3_6)
v3_9   = and(t3_9, c3_9)
c3_10 = or(u3_9, v3_9)
tL3_10   = xor(pp_3_7, c3_10)
s3_10   = xor(tL3_10, q2_10)
uL3_10   = and(pp_3_7, c3_10)
vL3_10   = and(tL3_10, q2_10)
q3_11 = or(uL3_10, vL3_10)

# === Row 4: add A4*B (cols 4..11) into running sum ===
P4   = xor(s3_4, pp_4_0)
c4_5 = and(s3_4, pp_4_0)
t4_5   = xor(s3_5, pp_4_1)
s4_5   = xor(t4_5, c4_5)
u4_5   = and(s3_5, pp_4_1)
v4_5   = and(t4_5, c4_5)
c4_6 = or(u4_5, v4_5)
t4_6   = xor(s3_6, pp_4_2)
s4_6   = xor(t4_6, c4_6)
u4_6   = and(s3_6, pp_4_2)
v4_6   = and(t4_6, c4_6)
c4_7 = or(u4_6, v4_6)
t4_7   = xor(s3_7, pp_4_3)
s4_7   = xor(t4_7, c4_7)
u4_7   = and(s3_7, pp_4_3)
v4_7   = and(t4_7, c4_7)
c4_8 = or(u4_7, v4_7)
t4_8   = xor(s3_8, pp_4_4)
s4_8   = xor(t4_8, c4_8)
u4_8   = and(s3_8, pp_4_4)
v4_8   = and(t4_8, c4_8)
c4_9 = or(u4_8, v4_8)
t4_9   = xor(s3_9, pp_4_5)
s4_9   = xor(t4_9, c4_9)
u4_9   = and(s3_9, pp_4_5)
v4_9   = and(t4_9, c4_9)
c4_10 = or(u4_9, v4_9)
t4_10   = xor(s3_10, pp_4_6)
s4_10   = xor(t4_10, c4_10)
u4_10   = and(s3_10, pp_4_6)
v4_10   = and(t4_10, c4_10)
c4_11 = or(u4_10, v4_10)
tL4_11   = xor(pp_4_7, c4_11)
s4_11   = xor(tL4_11, q3_11)
uL4_11   = and(pp_4_7, c4_11)
vL4_11   = and(tL4_11, q3_11)
q4_12 = or(uL4_11, vL4_11)

# === Row 5: add A5*B (cols 5..12) into running sum ===
P5   = xor(s4_5, pp_5_0)
c5_6 = and(s4_5, pp_5_0)
t5_6   = xor(s4_6, pp_5_1)
s5_6   = xor(t5_6, c5_6)
u5_6   = and(s4_6, pp_5_1)
v5_6   = and(t5_6, c5_6)
c5_7 = or(u5_6, v5_6)
t5_7   = xor(s4_7, pp_5_2)
s5_7   = xor(t5_7, c5_7)
u5_7   = and(s4_7, pp_5_2)
v5_7   = and(t5_7, c5_7)
c5_8 = or(u5_7, v5_7)
t5_8   = xor(s4_8, pp_5_3)
s5_8   = xor(t5_8, c5_8)
u5_8   = and(s4_8, pp_5_3)
v5_8   = and(t5_8, c5_8)
c5_9 = or(u5_8, v5_8)
t5_9   = xor(s4_9, pp_5_4)
s5_9   = xor(t5_9, c5_9)
u5_9   = and(s4_9, pp_5_4)
v5_9   = and(t5_9, c5_9)
c5_10 = or(u5_9, v5_9)
t5_10   = xor(s4_10, pp_5_5)
s5_10   = xor(t5_10, c5_10)
u5_10   = and(s4_10, pp_5_5)
v5_10   = and(t5_10, c5_10)
c5_11 = or(u5_10, v5_10)
t5_11   = xor(s4_11, pp_5_6)
s5_11   = xor(t5_11, c5_11)
u5_11   = and(s4_11, pp_5_6)
v5_11   = and(t5_11, c5_11)
c5_12 = or(u5_11, v5_11)
tL5_12   = xor(pp_5_7, c5_12)
s5_12   = xor(tL5_12, q4_12)
uL5_12   = and(pp_5_7, c5_12)
vL5_12   = and(tL5_12, q4_12)
q5_13 = or(uL5_12, vL5_12)

# === Row 6: add A6*B (cols 6..13) into running sum ===
P6   = xor(s5_6, pp_6_0)
c6_7 = and(s5_6, pp_6_0)
t6_7   = xor(s5_7, pp_6_1)
s6_7   = xor(t6_7, c6_7)
u6_7   = and(s5_7, pp_6_1)
v6_7   = and(t6_7, c6_7)
c6_8 = or(u6_7, v6_7)
t6_8   = xor(s5_8, pp_6_2)
s6_8   = xor(t6_8, c6_8)
u6_8   = and(s5_8, pp_6_2)
v6_8   = and(t6_8, c6_8)
c6_9 = or(u6_8, v6_8)
t6_9   = xor(s5_9, pp_6_3)
s6_9   = xor(t6_9, c6_9)
u6_9   = and(s5_9, pp_6_3)
v6_9   = and(t6_9, c6_9)
c6_10 = or(u6_9, v6_9)
t6_10   = xor(s5_10, pp_6_4)
s6_10   = xor(t6_10, c6_10)
u6_10   = and(s5_10, pp_6_4)
v6_10   = and(t6_10, c6_10)
c6_11 = or(u6_10, v6_10)
t6_11   = xor(s5_11, pp_6_5)
s6_11   = xor(t6_11, c6_11)
u6_11   = and(s5_11, pp_6_5)
v6_11   = and(t6_11, c6_11)
c6_12 = or(u6_11, v6_11)
t6_12   = xor(s5_12, pp_6_6)
s6_12   = xor(t6_12, c6_12)
u6_12   = and(s5_12, pp_6_6)
v6_12   = and(t6_12, c6_12)
c6_13 = or(u6_12, v6_12)
tL6_13   = xor(pp_6_7, c6_13)
s6_13   = xor(tL6_13, q5_13)
uL6_13   = and(pp_6_7, c6_13)
vL6_13   = and(tL6_13, q5_13)
q6_14 = or(uL6_13, vL6_13)

# === Row 7: add A7*B (cols 7..14) into running sum ===
P7   = xor(s6_7, pp_7_0)
c7_8 = and(s6_7, pp_7_0)
t7_8   = xor(s6_8, pp_7_1)
P8   = xor(t7_8, c7_8)
u7_8   = and(s6_8, pp_7_1)
v7_8   = and(t7_8, c7_8)
c7_9 = or(u7_8, v7_8)
t7_9   = xor(s6_9, pp_7_2)
P9   = xor(t7_9, c7_9)
u7_9   = and(s6_9, pp_7_2)
v7_9   = and(t7_9, c7_9)
c7_10 = or(u7_9, v7_9)
t7_10   = xor(s6_10, pp_7_3)
P10   = xor(t7_10, c7_10)
u7_10   = and(s6_10, pp_7_3)
v7_10   = and(t7_10, c7_10)
c7_11 = or(u7_10, v7_10)
t7_11   = xor(s6_11, pp_7_4)
P11   = xor(t7_11, c7_11)
u7_11   = and(s6_11, pp_7_4)
v7_11   = and(t7_11, c7_11)
c7_12 = or(u7_11, v7_11)
t7_12   = xor(s6_12, pp_7_5)
P12   = xor(t7_12, c7_12)
u7_12   = and(s6_12, pp_7_5)
v7_12   = and(t7_12, c7_12)
c7_13 = or(u7_12, v7_12)
t7_13   = xor(s6_13, pp_7_6)
P13   = xor(t7_13, c7_13)
u7_13   = and(s6_13, pp_7_6)
v7_13   = and(t7_13, c7_13)
c7_14 = or(u7_13, v7_13)
tL7_14   = xor(pp_7_7, c7_14)
P14   = xor(tL7_14, q6_14)
uL7_14   = and(pp_7_7, c7_14)
vL7_14   = and(tL7_14, q6_14)
P15 = or(uL7_14, vL7_14)

